{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "types": []
  },
  "include": [
    "src/contracts.ts",
    "src/page-data.ts",
    "src/model-data.ts",
    "src/store.ts",
    "src/setup-metadata.ts",
    "src/policy.ts",
    "src/provider-auth.ts",
    "src/credential-resolver.ts",
    "src/provider-admission.ts",
    "src/native-provider.ts",
    "src/admission.ts",
    "src/receipts.ts",
    "src/recovery.ts",
    "src/recovery-applier.ts",
    "src/config.ts",
    "src/provider-profiles.ts",
    "src/desktop-bridge.ts",
    "src/session-map.ts",
    "src/agent-context-tools.ts",
    "src/subagents.ts",
    "src/node-sqlite.d.ts",
    "src/policy-node.d.ts",
    "src/node-child-process.d.ts",
    "src/workspace-tools-node.d.ts",
    "src/workspace-tools.ts",
    "src/tool-dispatch.ts"
  ]
}
