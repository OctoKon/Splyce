+
+const context: Context = { messages: [{ role: "user", content: "hi", timestamp: 1 }] };
+
+const leaseOf = (secret: string, onUse?: () => void): SplyceCredentials => ({
+	lease: {
+		use: async (consume) => {
+			onUse?.();
+			return consume(secret);
+		},
+	},
+	redact: (text) => text.split(secret).join("[redacted]"),
