+const bedrockLease = (onUse?: () => void, json = LEASED_KEY_JSON): SplyceCredentials => ({
+	lease: {
+		use: async (consume) => {
+			onUse?.();
+			return consume(json);
+		},
+	},
+	redact: (text) => text.split(SECRET).join("[redacted]"),
